# ===================== REQUIRED =====================
# --- Store ---
STORE_NAME=Jia Express
SITE_URL=https://jiaexpress.com
SITEMAP_URL=https://jiaexpress.com/sitemap.xml

# --- WooCommerce (WP Admin > WooCommerce > Settings > Advanced > REST API, permission: Read) ---
WOO_URL=https://web.jiaexpress.com
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx

# --- Chatwoot ---
CHATWOOT_URL=https://your-chatwoot-address
# Access token of the Agent Bot (Super Admin > Agent Bots > your bot)
CHATWOOT_BOT_TOKEN=xxxxxxxxxxxxxxxx

# --- Secrets: make up two long random strings (openssl rand -hex 24) ---
WEBHOOK_TOKEN=change-me-long-random-string
ADMIN_TOKEN=change-me-another-long-random-string

# --- Free AI: Gemini first, Groq as backup ---
LLM_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ===================== OPTIONAL (leave empty for defaults) =====================
# Extra rules for the bot, e.g. "We ship only within India. COD available."
EXTRA_INSTRUCTIONS=
# Second backup AI (https://openrouter.ai/keys, pick a model ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Product cards: how many per answer (default 10), show photos (default false)
MAX_PRODUCT_CARDS=10
SHOW_PRODUCT_IMAGES=false
# true = the AI may move a chat to a human by itself. Default false: only when the customer asks.
AUTO_HANDOFF=false
# Message when the customer asks for a human
HANDOFF_MESSAGE=Sure! I'm connecting you with our team. Someone will reply here shortly.
# Currency symbol (default: read from WooCommerce)
CURRENCY_SYMBOL=
# Product link format on your storefront (default {site}/product/{slug})
PRODUCT_LINK_TEMPLATE=
# How often to re-read the website and key pages, in hours (default 24)
SYNC_INTERVAL_HOURS=24
