# ========== YOUR STORE ==========
STORE_NAME=My Shop
SITE_URL=https://yourshop.com
# Yoast / RankMath usually use sitemap_index.xml; WordPress core uses wp-sitemap.xml
SITEMAP_URL=https://yourshop.com/sitemap_index.xml
# Optional extra rules for the bot, e.g. "We ship only within India. COD available above Rs 500."
EXTRA_INSTRUCTIONS=

# ========== WOOCOMMERCE (WooCommerce > Settings > Advanced > REST API, permission: Read) ==========
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxx

# ========== CHATWOOT ==========
CHATWOOT_URL=https://chat.yourshop.com
# Access token of the Agent Bot (Settings > Bots > your bot)
CHATWOOT_BOT_TOKEN=xxxxxxxxxxxxxxxx

# ========== SECRETS (make up long random strings: openssl rand -hex 24) ==========
WEBHOOK_TOKEN=change-me-long-random-string
ADMIN_TOKEN=change-me-another-long-random-string

# ========== FREE AI PROVIDERS (tried in order, first one that works answers) ==========
LLM_PROVIDERS=gemini,groq,openrouter
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free key: https://openrouter.ai/keys   (pick any model ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Only if you run the optional Ollama container
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# ========== OPTIONAL TUNING ==========
SYNC_INTERVAL_HOURS=24
SITEMAP_EXCLUDE=/(cart|checkout|my-account|wp-login|wp-admin|feed|author|tag)(/|$)|\?add-to-cart=
PRODUCT_URL_PATTERN=/product/
MAX_PAGES=3000
BOT_ONLY_PENDING=true
HANDOFF_MESSAGE=Sure! I'm connecting you with our team. Someone will reply here shortly.
